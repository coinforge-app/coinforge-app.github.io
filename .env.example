# Optional platform fee charged on token creation (leave VITE_FEE_WALLET empty to disable all fees)
VITE_FEE_WALLET=
# Base fee per token creation, in SOL
VITE_FEE_SOL=0.1
# Extra fee per add-on (each revoke, custom creator info), in SOL
VITE_FEE_ADDON_SOL=0.1

# Optional default RPC endpoints for all visitors (e.g. Helius). The key ends up in the public bundle,
# so restrict it to your domain in the Helius dashboard.
VITE_RPC_MAINNET=
VITE_RPC_DEVNET=

# Homepage promotions: price in SOL and duration per payment (paid to VITE_FEE_WALLET)
VITE_PROMO_SOL=0.05
VITE_PROMO_HOURS=24
# Boost tiers: Boost ranks above basic, Top Spot is pinned to #1
VITE_PROMO_BOOST_SOL=0.12
VITE_PROMO_TOP_SOL=0.25
# Comma-separated token mints to hide from the promoted list
VITE_PROMO_BLOCKLIST=

# Referral program: share of every platform fee paid instantly to the referrer (?ref=<wallet>), max 50
VITE_REF_PERCENT=30
